<a href="/" class="btn btn-outline-secondary btn-sm mb-3">← Volver</a>

<div class="card">
  <div class="card-body">
    <h2 class="mb-1">Haz tu pregunta</h2>
    <p class="text-secondary small mb-4">Publicando como 👤 <strong>{{user.username}}</strong></p>

    {{#if error}}
      <div class="alert alert-danger">{{error}}</div>
    {{/if}}

    <form action="/preguntar" method="POST">
      <div class="mb-3">
        <label class="form-label">Título</label>
        <input type="text" name="title" class="form-control" maxlength="200"
               placeholder="Resume tu duda en una frase" value="{{title}}" required>
      </div>

      <div class="mb-3">
        <label class="form-label">Detalle</label>
        <textarea name="content" class="form-control" rows="5"
                  placeholder="Explica tu duda con detalle" required>{{content}}</textarea>
      </div>

      <button type="submit" class="btn btn-rojo">Publicar</button>
    </form>
  </div>
</div>