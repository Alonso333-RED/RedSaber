<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>RedSaber</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/styles.css" rel="stylesheet">
</head>
<body>
<nav class="navbar navbar-expand bg-white border-bottom sticky-top">
  <div class="container">
    <a class="navbar-brand fw-bold fs-4" href="/">Red<span>Saber</span></a>

    <div class="d-flex align-items-center gap-2">
      <a href="/preguntar" class="btn btn-rojo">+ Preguntar</a>

      {{#if currentUser}}
        <span class="text-secondary small">👤 <strong>{{currentUser.username}}</strong></span>
        <form action="/logout" method="POST" class="m-0">
          <button type="submit" class="btn btn-outline-secondary">Salir</button>
        </form>
      {{else}}
        <a href="/login" class="btn btn-outline-secondary">Entrar</a>
        <a href="/registro" class="btn btn-outline-secondary">Crear cuenta</a>
      {{/if}}
    </div>
  </div>
</nav>

  <main class="container py-4">
    {{{body}}}
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>