<a href="/" class="btn btn-outline-secondary btn-sm mb-3">← Volver</a>

<div class="card">
  <div class="card-body">
    <p class="text-secondary small mb-2">👤 {{author.username}}</p>
    <h2 class="card-title">{{question.title}}</h2>
    <p class="card-text mt-3">{{question.content}}</p>
  </div>
</div>

<h4 class="mt-4 mb-3">Respuestas ({{answers.length}})</h4>

{{#if answers.length}}
  <div class="d-flex flex-column gap-3 mb-4">
    {{#each answers}}
      <div class="card">
        <div class="card-body">
          <p class="text-secondary small mb-2">👤 {{this.author}}</p>
          <p class="card-text mb-0">{{this.content}}</p>
        </div>
      </div>
    {{/each}}
  </div>
{{else}}
  <p class="text-secondary">Aún nadie ha respondido esta pregunta.</p>
{{/if}}

{{#if user}}
  <div class="card">
    <div class="card-body">
      <h5 class="mb-1">Tu respuesta</h5>
      <p class="text-secondary small mb-3">Respondiendo como 👤 <strong>{{user.username}}</strong></p>

      <form action="/pregunta/{{question.id_question}}/responder" method="POST">
        <div class="mb-3">
          <textarea name="content" class="form-control" rows="4"
                    placeholder="Explica paso a paso..." required></textarea>
        </div>
        <button type="submit" class="btn btn-rojo">Responder</button>
      </form>
    </div>
  </div>
{{else}}
  <div class="alert alert-warning text-center mb-0">
    Para responder necesitas <a href="/login">iniciar sesión</a>.
  </div>
{{/if}}