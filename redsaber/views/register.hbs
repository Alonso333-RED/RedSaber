<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <div class="card">
      <div class="card-body">
        <h2 class="mb-4">Crear cuenta</h2>

        {{#if ok}}
          <div class="alert alert-success">¡Cuenta creada! Ya eres parte de RedSaber.</div>
        {{/if}}

        {{#if error}}
          <div class="alert alert-danger">{{error}}</div>
        {{/if}}

        <form action="/registro" method="POST">
          <div class="mb-3">
            <label class="form-label">Usuario</label>
            <input type="text" name="username" class="form-control" maxlength="50" value="{{username}}" required>
          </div>

          <div class="mb-3">
            <label class="form-label">Contraseña (mínimo 6 caracteres)</label>
            <input type="password" name="password" class="form-control" minlength="6" required>
          </div>

          <button type="submit" class="btn btn-rojo w-100">Crear cuenta</button>
        </form>
      </div>
    </div>
  </div>
</div>